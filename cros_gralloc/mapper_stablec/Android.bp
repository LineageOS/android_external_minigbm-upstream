package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "external_minigbm_license_upstream"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    default_applicable_licenses: ["external_minigbm_license_upstream"],
}

cc_library_shared {
    name: "mapper.minigbm_upstream",
    defaults: ["minigbm_gralloc4_common_defaults_upstream"],
    vintf_fragments: select(soong_config_variable("minigbm_upstream", "include_vintf_fragments"), {
        false: [],
        default: ["mapper.minigbm_upstream.xml"],
    }),
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
        "libminigbm_gralloc_upstream",
    ],
    header_libs: [
        "libbase_headers",
        "libimapper_providerutils",
        "libimapper_stablec",
    ],
    srcs: [
        ":minigbm_gralloc4_mapper_files_upstream",
        "Mapper.cpp",
    ],
    cpp_std: "c++20",
}

prebuilt_etc {
    name: "mapper.minigbm_upstream.xml",
    src: "mapper.minigbm_upstream.xml",
    sub_dir: "vintf",
    installable: false,
}
